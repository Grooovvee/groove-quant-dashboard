    font-size: 13px; font-weight: bold; color: var(--neon-cyan); letter-spacing: 1px;
  }
  .council-card {
    background: rgba(0, 0, 0, 0.4); border-left: 3px solid var(--neon-cyan);
    padding: 8px 10px; margin-bottom: 6px; border-radius: 0 4px 4px 0;
  }
