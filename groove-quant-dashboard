  .bot-chip:hover { border-color: var(--neon-cyan); }
  .bot-chip .b-top { display: flex; justify-content: space-between; font-weight: bold; }
  .bot-chip .b-meta { display: flex; justify-content: space-between; color: #8b949e; margin-top: 4px; font-size: 9px; }
  .tag-lvl { background: rgba(0, 255, 102, 0.2); color: var(--neon-green); padding: 1px 4px; border-radius: 2px; }

  .terminal-box {
    background: #020408; border: 1px solid rgba(0, 240, 255, 0.3);
    font-size: 11px; padding: 10px; height: 320px; overflow-y: auto; border-radius: 4px;
