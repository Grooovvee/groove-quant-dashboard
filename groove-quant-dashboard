  .c-desc { font-size: 10px; color: #8b949e; margin-top: 3px; }

  .tabs { display: flex; gap: 5px; overflow-x: auto; padding-bottom: 4px; }
  .tab-btn {
    background: rgba(0, 240, 255, 0.1); border: 1px solid var(--hud-border);
    color: #fff; padding: 6px 10px; font-family: inherit;
    font-size: 11px; cursor: pointer; border-radius: 3px; transition: 0.2s;
  }
  .tab-btn.active, .tab-btn:hover {
    background: var(--neon-cyan); color: #000; font-weight: bold;
    box-shadow: 0 0 10px var(--neon-cyan);
  }
  .bot-list {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;
    max-height: 480px; overflow-y: auto; padding-right: 4px;
  }
  .bot-chip {
    background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px; border-radius: 4px; font-size: 11px; cursor: pointer;
    transition: 0.2s;
