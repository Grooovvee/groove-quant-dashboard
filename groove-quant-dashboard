    padding-bottom: 15px; margin-bottom: 20px;
    box-shadow: 0 4px 20px rgba(0, 240, 255, 0.15);
  }
  .brand h1 {
    font-size: 24px; font-weight: 900;
    color: #fff; text-shadow: 0 0 10px var(--neon-cyan);
